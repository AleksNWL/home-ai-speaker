[Unit]
Description=Home AI Speaker orchestrator
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# Change User= if you don't run as root (add that user to group audio)
User=root
Group=audio
WorkingDirectory=/root/home-ai-speaker
Environment=PYTHONUNBUFFERED=1
Environment=HAS_CONFIG=/root/home-ai-speaker/config/default.yaml
Environment=HAS_SECRETS=/root/home-ai-speaker/config/secrets.yaml
ExecStart=/root/home-ai-speaker/.venv/bin/python -m src.orchestrator
Restart=on-failure
RestartSec=3

# Nice for voice latency on small boards
Nice=-5

[Install]
WantedBy=multi-user.target
